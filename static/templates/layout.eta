<% layout("./base") %>
<header class="navbar-smart">
    <div class="navbar-container">
        <a href="/" class="logo-smart">
            <span class="logo-dino-badge">🦕</span>SmartDeno
        </a>
        <nav class="nav nav-masthead">
            <a id="menuitem0" class="nav-link active" aria-current="page" href="/">Home</a>
            <a id="menuitem1" class="nav-link" href="/features">Features</a>
            <a id="menuitem2" class="nav-link" href="/restapi">API</a>
            <% if (it.sessionUser) { %>
                <a id="menuitem3" class="nav-link" href="/logout">Logout</a>
            <% } else { %>
                <a id="menuitem3" class="nav-link" href="/login">Login</a>
            <% } %>
        </nav>
    </div>
</header>

<main class="main-content">
    <%~ it.body %>
</main>

<footer class="footer-smart">
    <div class="footer-container">
        <div>
            <% if (it.sessionUser) { %>
                You are logged in as <b class="text-dark"><%= it.sessionUser %></b>. <a href="/logout" class="footer-link">Logout</a>.
            <% } else { %>
                <%= it.appName %> v<%= it.appVersion %> is powered by
                <a href="https://deno.land/" target="_blank" class="footer-link">Deno</a>.
            <% } %>
        </div>
        <div>
            &copy; <%= new Date().getFullYear() %> SmartDeno.
        </div>
    </div>
</footer>
