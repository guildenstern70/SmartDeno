<% layout("./layout") %>
<div class="container text-center">
    <!-- Hero Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="hero-badge">
                <span>🦕</span> Powered by Deno &amp; Oak
            </div>
            
            <h1 class="hero-title">
                The <span class="hero-highlight">smart</span> way to build Deno apps.
            </h1>
            
            <p class="hero-subtitle">
                <%= it.appDescription %>
                <% if (it.sessionUser) { %>
                    <strong class="text-dark"><%= it.sessionUser %></strong>.
                <% } %>
                SmartDeno combines Deno KV, Oak HTTP, Eta templates, and sessions into a high-performance web template.
            </p>
            
            <div class="d-flex justify-content-center gap-3">
                <a href="/features" class="btn-smart btn-smart-primary">
                    Get Started
                </a>
                <% if (!it.sessionUser) { %>
                    <a href="/login" class="btn-smart btn-smart-secondary">
                        Sign In
                    </a>
                <% } else { %>
                    <a href="/restapi" class="btn-smart btn-smart-outline">
                        Explore REST API
                    </a>
                <% } %>
            </div>

            <div class="mt-4 text-muted" style="font-size: 1rem;">
                Start building today: <a href="https://github.com/guildenstern70/SmartDeno" target="_blank" rel="noopener noreferrer" class="text-dark fw-bold text-decoration-underline" style="transition: opacity 0.2s ease;">go to source code</a>
            </div>
        </div>
    </div>

    <!-- Interactive Counter Demo -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="counter-card">
                <h4 class="fw-bold mb-2">Interactive Counter</h4>
                <p class="text-muted small mb-4">
                    The classic Deno interactive counter component. Test client-side reactivity below:
                </p>
                <div class="counter-container">
                    <button class="counter-btn" id="btn-decrement" aria-label="Decrement">-</button>
                    <span class="counter-val" id="counter-value">3</span>
                    <button class="counter-btn" id="btn-increment" aria-label="Increment">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Showcase Cover Image -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="cover-frame">
                <img class="cover-image" src="/img/cover_wide.jpeg" alt="Deno cover illustration">
            </div>
        </div>
    </div>
</div>

<script src="/js/index.js"></script>
